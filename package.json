{
  "name": "dev-career-ready-monorepo",
  "private": "true",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "clean": "rm -rf node_modules bun.lock bun.lockb apps/web/node_modules apps/api/node_modules apps/mobile/node_modules packages/shared/node_modules",
    "dev:web": "bun run --filter web dev",
    "build:web": "bun run --filter web build",
    "dev:api": "bun run --filter api dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "dev:mobile:ios": "bun run --cwd apps/mobile ios",
    "dev:mobile:android": "bun run --cwd apps/mobile android",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "type-check": "bun run --filter '*' type-check && bun run lint:fix",
    "env:pull:web": "bun run --filter web env:pull"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/eslint-plugin-query": "5.101.1",
    "eslint": "10.5.0",
    "eslint-config-expo": "57.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2"
  },
  "dependencies": {
    "better-auth": "1.6.23",
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "resolutions": {
    "react-native-css": "3.0.7",
    "lightningcss": "1.30.1"
  }
}
